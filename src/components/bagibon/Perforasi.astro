---
// Divider perforasi: barisan lubang SVG (pattern), antar section timeline.
export interface Props {
  class?: string;
}
const { class: cls = '' } = Astro.props;
---

<svg class={cls} viewBox="0 0 1200 24" preserveAspectRatio="none" aria-hidden="true" style="width:100%;height:22px;display:block;opacity:.55;margin:.5rem 0;">
  <defs>
    <pattern id="perf-holes" width="32" height="24" patternUnits="userSpaceOnUse">
      <circle cx="16" cy="12" r="5" fill="var(--text)" />
    </pattern>
  </defs>
  <rect x="0" y="0" width="1200" height="24" fill="url(#perf-holes)" />
</svg>
