---
import { Icon } from 'astro-icon/components';
import BukuIcon from './BukuIcon.astro';
import UangBelahIcon from './UangBelahIcon.astro';
import StampLunas from './StampLunas.astro';
import Perforasi from './Perforasi.astro';
---

<div class="tl wrap" id="buku-timeline">
  <div class="tl-spine" aria-hidden="true"></div>

  <!-- ============ NODE 1: PESERTA ============ -->
  <section class="tl-node" id="peserta" aria-labelledby="h-peserta">
    <div class="tl-dot" data-n="1" aria-hidden="true"></div>
    <div data-wipe>
      <h2 id="h-peserta" class="sr-only">Siapa yang makan bareng?</h2>
      <svg viewBox="0 0 600 130" style="width:100%;max-width:34rem;" aria-hidden="true">
        <defs><path id="curve-peserta" d="M25,105 Q300,15 575,95" fill="none" /></defs>
        <text class="curve-title"><textPath href="#curve-peserta" startOffset="50%" text-anchor="middle">siapa yang makan bareng?</textPath></text>
      </svg>
      <p class="bendahara">tulis namanya dulu, jangan asal</p>
      <div class="book-card taped stack" style="margin-top:1rem;">
        <form id="form-peserta" class="field" autocomplete="off">
          <label for="p-name"><span class="lbl">Nama peserta</span></label>
          <div style="display:flex;gap:.5rem;">
            <input class="inp" id="p-name" name="p-name" type="text" maxlength="24" placeholder="cth: Budi" />
            <button class="btn icon-only" type="submit" aria-label="Tambah peserta">
              <Icon name="ph:user-plus-bold" />
            </button>
          </div>
          <p class="hint" id="p-error" role="alert" hidden></p>
        </form>
        <div id="p-empty" class="bendahara warn">belum ada yang nulis nama, gimana mau patungan?</div>
        <ul id="p-list" class="stack" style="list-style:none;padding:0;margin:0;"></ul>
        <div class="perforation" style="margin:1rem 0 .25rem;"></div>
        <p class="hint"><strong>Males nulis?</strong> Pakai contoh Bu Bendahara <span class="hint">(harga contoh, bukan harga beneran)</span>:</p>
        <div style="display:flex;flex-wrap:wrap;gap:.5rem;">
          <button type="button" class="btn small ghost" data-preset="kopi"><Icon name="ph:coffee-bold" />Warung Kopi Sore</button>
          <button type="button" class="btn small ghost" data-preset="warteg"><Icon name="ph:bowl-food-bold" />Warteg Bahari</button>
          <button type="button" class="btn small ghost" data-preset="kafe"><Icon name="ph:cake-bold" />Kafe Nongkrong</button>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ NODE 2: ITEM ============ -->
  <section class="tl-node" id="item" aria-labelledby="h-item">
    <div class="tl-dot" data-n="2" aria-hidden="true"></div>
    <div data-wipe>
      <h2 id="h-item" class="sr-only">Apa aja yang dipesan?</h2>
      <svg viewBox="0 0 600 130" style="width:100%;max-width:34rem;" aria-hidden="true">
        <defs><path id="curve-item" d="M25,95 Q300,115 575,30" fill="none" /></defs>
        <text class="curve-title"><textPath href="#curve-item" startOffset="50%" text-anchor="middle">apa aja yang dipesan?</textPath></text>
      </svg>
      <p class="bendahara">satu-satu ditulis, biar adil per item</p>
      <div class="book-card stack" style="margin-top:1rem;">
        <form id="form-item" class="stack" autocomplete="off">
          <div class="field">
            <label for="i-name"><span class="lbl">Nama makanan/minuman</span></label>
            <input class="inp" id="i-name" name="i-name" type="text" maxlength="40" placeholder="cth: kopi susu gula aren" />
          </div>
          <div class="field">
            <label for="i-price"><span class="lbl">Harga (Rp)</span></label>
            <input class="inp" id="i-price" name="i-price" type="number" inputmode="numeric" min="1" step="1" placeholder="cth: 15000" />
          </div>
          <fieldset style="border:none;padding:0;margin:0;">
            <legend class="lbl" style="font-weight:700;font-size:1rem;margin-bottom:.35rem;">Siapa yang makan item ini?</legend>
            <div id="i-eaters" style="display:flex;flex-wrap:wrap;gap:.5rem;"></div>
            <p class="hint" id="i-eaters-hint">isi nama peserta dulu di atas.</p>
          </fieldset>
          <button class="btn" type="submit"><Icon name="ph:receipt-bold" />Catat ke bon</button>
          <p class="hint" id="i-error" role="alert" hidden></p>
        </form>
        <div class="perforation" style="margin:1rem 0 .25rem;"></div>
        <div id="i-empty" class="bendahara warn">bonnya masih kosong — tulis pesanannya satu-satu ya.</div>
        <ul id="i-list" class="stack" style="list-style:none;padding:0;margin:0;"></ul>
      </div>
    </div>
  </section>

  <!-- ============ NODE 3: PAJAK & NOMBOK ============ -->
  <section class="tl-node" id="pajak" aria-labelledby="h-pajak">
    <div class="tl-dot" data-n="3" aria-hidden="true"></div>
    <div data-wipe>
      <h2 id="h-pajak" class="sr-only">Pajak, service, dan yang bayar duluan</h2>
      <svg viewBox="0 0 600 130" style="width:100%;max-width:34rem;" aria-hidden="true">
        <defs><path id="curve-pajak" d="M25,100 Q300,20 575,100" fill="none" /></defs>
        <text class="curve-title"><textPath href="#curve-pajak" startOffset="50%" text-anchor="middle">pajak & yang nombok</textPath></text>
      </svg>
      <p class="bendahara">pajak/service diisi manual ya, jangan asal tebak</p>
      <div class="book-card stack" style="margin-top:1rem;">
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:.75rem;">
          <div class="field">
            <label for="tax"><span class="lbl">Pajak (%)</span></label>
            <input class="inp" id="tax" type="number" inputmode="decimal" min="0" max="100" step="any" placeholder="cth: 10" />
          </div>
          <div class="field">
            <label for="service"><span class="lbl">Service (%)</span></label>
            <input class="inp" id="service" type="number" inputmode="decimal" min="0" max="100" step="any" placeholder="cth: 5" />
          </div>
        </div>
        <div class="field">
          <label for="payer"><span class="lbl"><UangBelahIcon class="inline" /> Yang bayar duluan (nombok)</span></label>
          <select class="inp" id="payer">
            <option value="">— belum ada yang bayar —</option>
          </select>
          <p class="hint">Yang nombok dibalikin sama yang lain sesuai hitungan di bawah.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ NODE 4: HASIL ============ -->
  <section class="tl-node" id="hasil" aria-labelledby="h-hasil">
    <div class="tl-dot" data-n="4" aria-hidden="true"></div>
    <div data-wipe>
      <h2 id="h-hasil" class="sr-only">Hasil hitungannya</h2>
      <svg viewBox="0 0 600 130" style="width:100%;max-width:34rem;" aria-hidden="true">
        <defs><path id="curve-hasil" d="M25,90 Q300,120 575,40" fill="none" /></defs>
        <text class="curve-title"><textPath href="#curve-hasil" startOffset="50%" text-anchor="middle">hasil hitungannya</textPath></text>
      </svg>
      <div class="book-card taped stack" style="margin-top:1rem;">
        <p class="hint" style="margin:0;">Total bon <span class="hint">(otomatis kehitung pas bon diubah)</span></p>
        <div class="odometer" id="total-odometer" aria-live="polite">Rp0</div>
        <div id="r-empty" class="bendahara warn">lengkapi dulu nama + bonnya, baru Bu Bendahara hitung.</div>
        <div id="results" class="stack" style="margin:0;"></div>
        <button type="button" class="btn small green" id="share-wa-2" style="align-self:flex-start;">Salin ringkasan WA</button>
        <div id="nombok-box" class="book-card stack" style="background:var(--accent);margin-top:1rem;" hidden>
          <p style="margin:0;font-weight:700;"><Icon name="ph:hand-coins-bold" /> <span id="nombok-text"></span></p>
        </div>
        <div style="display:flex;align-items:center;gap:1rem;flex-wrap:wrap;margin-top:.5rem;">
          <StampLunas />
          <div>
            <p class="bendahara good" id="egg-msg" hidden>ditunggu traktirannya!</p>
            <p class="hint" id="lunas-hint">kalau sudah beres semua, stempelnya dikasih.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ NODE 5: BAGIKAN ============ -->
  <section class="tl-node" id="bagikan" aria-labelledby="h-bagikan">
    <div class="tl-dot" data-n="5" aria-hidden="true"></div>
    <div data-wipe>
      <h2 id="h-bagikan" class="sr-only">Bagikan bonnya</h2>
      <svg viewBox="0 0 600 130" style="width:100%;max-width:34rem;" aria-hidden="true">
        <defs><path id="curve-bagi" d="M25,100 Q300,15 575,95" fill="none" /></defs>
        <text class="curve-title"><textPath href="#curve-bagi" startOffset="50%" text-anchor="middle">bagikan bonnya</textPath></text>
      </svg>
      <p class="bendahara">udah lunas semua, alhamdulillah</p>
      <div class="book-card stack" style="margin-top:1rem;">
        <div style="display:flex;flex-wrap:wrap;gap:.6rem;">
          <button type="button" class="btn green" id="share-wa"><Icon name="ph:copy-bold" />Salin ringkasan WA</button>
          <button type="button" class="btn blue" id="share-link"><Icon name="ph:link-simple-bold" />Salin tautan bon</button>
        </div>
        <div style="display:flex;flex-wrap:wrap;gap:.6rem;">
          <button type="button" class="btn ghost small" id="export-json"><Icon name="ph:download-simple-bold" />Unduh JSON</button>
          <label class="btn ghost small" for="import-json" style="cursor:pointer;"><Icon name="ph:upload-simple-bold" />Impor JSON</label>
          <input type="file" id="import-json" accept="application/json,.json" class="sr-only" />
          <button type="button" class="btn ghost small" id="print-btn"><Icon name="ph:printer-bold" />Cetak struk</button>
          <button type="button" class="btn ghost small" id="save-history"><Icon name="ph:archive-bold" />Simpan ke riwayat</button>
        </div>
        <p class="hint" id="share-status" role="status" aria-live="polite" style="margin:0;"></p>
        <div class="perforation" style="margin:1rem 0 .25rem;"></div>
        <h3 class="font-display" style="font-size:1.6rem;margin:0;"><BukuIcon class="inline" /> Riwayat bon</h3>
        <div id="hist-empty" class="bendahara">belum ada riwayat — simpan bon yang sudah beres biar gampang dibuka lagi.</div>
        <ul id="history-list" class="stack" style="list-style:none;padding:0;margin:0;"></ul>
      </div>
    </div>
  </section>
</div>

<Perforasi />
